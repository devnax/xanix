<section>
    <h1>
        <%= typeof title !=="undefined" ? title : "Hello" %>
    </h1>
    <p>
        <%= typeof message !=="undefined" ? message : "Welcome to Xanix." %>
    </p>

    <% if (typeof items !=="undefined" && items.length) { %>
        <ul>
            <% items.forEach(function (item) { %>
                <li>
                    <%= item %>
                </li>
                <% }) %>
        </ul>
        <% } %>
</section>